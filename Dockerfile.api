FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files
COPY PublicPolls.sln .
COPY src/PublicPolls.Domain/PublicPolls.Domain.csproj src/PublicPolls.Domain/
COPY src/PublicPolls.Application/PublicPolls.Application.csproj src/PublicPolls.Application/
COPY src/PublicPolls.Infrastructure/PublicPolls.Infrastructure.csproj src/PublicPolls.Infrastructure/
COPY src/PublicPolls.API/PublicPolls.API.csproj src/PublicPolls.API/

# Restore dependencies
RUN dotnet restore src/PublicPolls.API/PublicPolls.API.csproj

# Copy source code
COPY src/ src/

# Build and publish
WORKDIR /src/src/PublicPolls.API
RUN dotnet publish -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 80
EXPOSE 443

ENTRYPOINT ["dotnet", "PublicPolls.API.dll"]
