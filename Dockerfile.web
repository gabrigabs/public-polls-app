FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project file
COPY src/PublicPolls.Web/PublicPolls.Web.csproj src/PublicPolls.Web/

# Restore dependencies
RUN dotnet restore src/PublicPolls.Web/PublicPolls.Web.csproj

# Copy source code
COPY src/PublicPolls.Web/ src/PublicPolls.Web/

# Build and publish
WORKDIR /src/src/PublicPolls.Web
RUN dotnet publish -c Release -o /app/publish

# Nginx stage for serving static files
FROM nginx:alpine AS runtime

# Copy published files to nginx
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
