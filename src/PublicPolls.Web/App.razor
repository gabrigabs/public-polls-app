<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Página não encontrada</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="page-container" style="text-align: center; padding-top: 4rem;">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h4" Class="my-4">Página não encontrada</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">Voltar ao início</MudButton>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private MudTheme _theme = new()
    {
        Palette = new PaletteLight()
        {
            Primary = "#1976D2",
            Secondary = "#424242",
            AppbarBackground = "#1976D2",
            Background = "#f5f5f5",
            Surface = "#ffffff",
            Error = "#d32f2f",
            Success = "#388e3c"
        },
        Typography = new Typography()
        {
            Default = new Default()
            {
                FontFamily = new[] { "Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif" }
            }
        }
    };
}
